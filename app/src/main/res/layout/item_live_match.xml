<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/surface_card">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Pulse Dot Indicator -->
        <View
            android:id="@+id/view_pulse_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/shape_live_dot"
            app:layout_constraintTop_toTopOf="@id/tv_live_tag"
            app:layout_constraintBottom_toBottomOf="@id/tv_live_tag"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- LIVE Badge Label -->
        <TextView
            android:id="@+id/tv_live_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="EN VIVO"
            android:textColor="@color/error_pulse"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/view_pulse_dot" />

        <!-- Elapsed Minute -->
        <TextView
            android:id="@+id/tv_live_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/secondary_sport"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/tv_live_tag"
            app:layout_constraintBottom_toBottomOf="@id/tv_live_tag"
            app:layout_constraintStart_toEndOf="@id/tv_live_tag"
            tools:text="74'" />

        <!-- League Name -->
        <TextView
            android:id="@+id/tv_live_league"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:alpha="0.7"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_live_time"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="La Liga" />

        <!-- Divider Line (Premium aesthetic) -->
        <View
            android:id="@+id/divider_line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/outline_border"
            android:alpha="0.4"
            app:layout_constraintTop_toBottomOf="@id/tv_live_tag" />

        <!-- Home Team Block -->
        <LinearLayout
            android:id="@+id/layout_home_team"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_match_score"
            app:layout_constraintTop_toBottomOf="@id/divider_line"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/img_home_badge"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="fitCenter"
                tools:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="Escudo local en vivo" />

            <TextView
                android:id="@+id/tv_home_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Barcelona" />

        </LinearLayout>

        <!-- Live Score -->
        <TextView
            android:id="@+id/tv_match_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/secondary_sport"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/layout_home_team"
            app:layout_constraintBottom_toBottomOf="@id/layout_home_team"
            app:layout_constraintStart_toEndOf="@id/layout_home_team"
            app:layout_constraintEnd_toStartOf="@id/layout_away_team"
            tools:text="3 - 2" />

        <!-- Away Team Block -->
        <LinearLayout
            android:id="@+id/layout_away_team"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintStart_toEndOf="@id/tv_match_score"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_line"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/img_away_badge"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="fitCenter"
                tools:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="Escudo visitante en vivo" />

            <TextView
                android:id="@+id/tv_away_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Real Madrid" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- CABECERA GLOBAL -->
    <TextView
        android:id="@+id/tv_title_global"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:text="Favoritos"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 1. VISTA DE INVITADO (GUEST / ANÓNIMO BLOCK) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_favorites_guest"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_title_global"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/img_lock"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/primary_sport"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tv_lock_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tv_lock_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Contenido Exclusivo"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/img_lock"
            app:layout_constraintBottom_toTopOf="@id/tv_lock_desc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_lock_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Inicia sesión con tu cuenta de usuario para poder guardar y sincronizar tus noticias, equipos y marcadores favoritos en tiempo real de forma segura."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tv_lock_title"
            app:layout_constraintBottom_toTopOf="@id/btn_lock_login"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_lock_login"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="Iniciar Sesión"
            android:textColor="@color/bg_dark"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_sport"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/tv_lock_desc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. VISTA DE CONTENIDO (USUARIO REGISTRADO) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layout_favorites_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:fillViewport="true"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/tv_title_global"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- SECCIÓN 1: NOTICIAS GUARDADAS -->
            <TextView
                android:id="@+id/tv_header_news"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:text="NOTICIAS GUARDADAS"
                android:textColor="@color/primary_sport"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:background="@color/primary_sport" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_fav_news"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/tv_empty_news"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:text="Aún no tienes noticias favoritas."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- SECCIÓN 2: MIS EQUIPOS -->
            <TextView
                android:id="@+id/tv_header_teams"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:text="MIS EQUIPOS FAVORITOS"
                android:textColor="@color/secondary_sport"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:background="@color/secondary_sport" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_fav_teams"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/tv_empty_teams"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:text="Aún no tienes equipos favoritos."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- SECCIÓN 3: PARTIDOS GUARDADOS -->
            <TextView
                android:id="@+id/tv_header_matches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:text="PARTIDOS GUARDADOS"
                android:textColor="@color/primary_sport"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:background="@color/primary_sport" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_fav_matches"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/tv_empty_matches"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:text="Aún no tienes partidos guardados."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

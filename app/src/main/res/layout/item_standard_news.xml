<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="240dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/surface_card">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- News Image -->
        <ImageView
            android:id="@+id/img_standard_news"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Imagen de noticia estándar" />

        <!-- Gradient Overlay for readability -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/hero_gradient" />

        <!-- Botón de Favoritos Flotante Premium -->
        <ImageView
             android:id="@+id/btn_news_favorite"
             android:layout_width="36dp"
             android:layout_height="36dp"
             android:layout_marginTop="12dp"
             android:layout_marginEnd="12dp"
             android:padding="8dp"
             android:background="@drawable/circle_dark_semi"
             android:src="@drawable/ic_heart"
             android:contentDescription="Añadir a favoritos"
             app:layout_constraintTop_toTopOf="parent"
             app:layout_constraintEnd_toEndOf="parent" />

        <!-- Content overlay container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Category tag -->
            <TextView
                android:id="@+id/tv_standard_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BALONCESTO"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:background="@color/outline_border"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <!-- Headline / Title -->
            <TextView
                android:id="@+id/tv_standard_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Draft Picks Finalized: Who Will Lead the Next Generation?"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Metadata (Time) -->
            <TextView
                android:id="@+id/tv_standard_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Hace 1 hr"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:alpha="0.8" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
